# Django
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOW_ALL=True
CSRF_TRUSTED_ORIGINS=

# Database — leave DATABASE_URL empty to use local SQLite (zero setup).
# For Postgres: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Business rules (also editable live from Django Admin -> Platform Settings)
SABZINO_DEFAULT_COMMISSION_PERCENT=10
SABZINO_DEFAULT_POINTS_PER_KG=2

# فاز ۱۱: پیامک واقعی (sms.ir) — فقط برای اعلان‌های متنی (پذیرش درخواست، تسویه).
# ورود/OTP عمداً همچنان ایمیل/رمز عبور است؛ خالی‌گذاشتن این دو یعنی پیامک
# غیرفعال می‌ماند و فقط در لاگ سرور دیده می‌شود، هیچ خطایی رخ نمی‌دهد.
SMS_IR_API_KEY=
SMS_IR_LINE_NUMBER=

# Map/geocoding provider key, if you swap the free OpenStreetMap tiles for a
# paid provider (e.g. Neshan, Mapbox).
MAP_API_KEY=
